# --- Supabase ---------------------------------------------------------
# Project Settings → API. The service-role key stays server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telegram ---------------------------------------------------------
# From @BotFather
BOT_TOKEN=123456789:AAExampleTokenTextGoesHere
# Public HTTPS URL of this app's /webhook route
WEBHOOK_URL=https://yourdomain.com/webhook
# Optional shared secret; when set it is sent to Telegram as
# secret_token and checked on every incoming webhook request.
WEBHOOK_SECRET=
# Your numeric Telegram ID — always an admin, works with no DB
ADMIN_TELEGRAM_ID=0

# --- Web UI -----------------------------------------------------------
# @username shown on the page's "Open in Telegram" link
BOT_USERNAME=YourBotUsername
PORT=3000
HOST=0.0.0.0
# Scratch dir for downloaded media. Serverless platforms mount the app
# directory read-only — on Vercel set TEMP_DIR=/tmp (it also falls back
# to os.tmpdir() automatically if this dir can't be created).
TEMP_DIR=storage/temp

# --- Features ---------------------------------------------------------
# YouTube Data API v3 key (powers search)
GOOGLE_API_KEY=
# On Vercel the project dir is read-only: use /tmp/app.log, or leave it
# empty to log to the `logs` table + console only.
LOG_FILE=storage/logs/app.log
CACHE_TTL=3600
# Lifetime of the YouTube download-menu buttons (seconds)
TOOL77_CACHE_TTL=3600
# Send-by-URL ceiling before falling back to download + multipart upload
MAX_URL_UPLOAD_BYTES=20971520
